server {
    listen 80;
    server_name arachnova.id;
    return 301 https://arachnova.id$request_uri;
}

server {
    listen 443 ssl http2;
    server_name arachnova.id www.arachnova.id;

    ssl_certificate /etc/letsencrypt/live/arachnova.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/arachnova.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    if ($host = www.arachnova.id) {
        return 301 https://arachnova.id$request_uri;
    }

    root /var/www/arachnova.id/dist;
    index index.html;

    client_max_body_size 50m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;

    # Vite build output: file names contain a content hash, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~ ^/(image|fonts)/ {
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # SPA shell: always revalidate so a deploy shows up immediately.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
